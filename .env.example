# Pooled Neon Postgres connection string. Copy to .env.local and fill in.
# .env* is git-ignored — never commit real values.
DATABASE_URL=

# Cloudflare R2 (T4-B2 brand-asset store — real presigned-PUT upload). CORNEL-OWNED
# infra: set these locally AND on Vercel. The build/typecheck are GREEN without them
# (lazy r2.ts); only the live upload walk needs them. The bucket also needs a CORS
# policy permitting browser PUT from the app origins (localhost + the Vercel domains).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Auth.js v5 (T6 — real auth). CORNEL-OWNED infra: set these locally AND on Vercel.
# The build/typecheck are GREEN without them (lazy auth config); only live sign-in needs
# them. AUTH_SECRET: `npx auth secret`. Google OAuth client redirect URIs must include
# http://localhost:3000/api/auth/callback/google + the Vercel domain. AUTH_EMAIL_FROM
# must be a VERIFIED Resend sender domain. AUTH_TRUST_HOST=true (or AUTH_URL) for local.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=
AUTH_TRUST_HOST=
AUTH_URL=

# The email seeded as the demo workspace OWNER (login email; the DISPLAY identity stays
# "Maya K." regardless). Defaults to amalacornel@gmail.com if unset (C1=A).
SEED_OWNER_EMAIL=
