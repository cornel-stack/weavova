# Pooled Neon Postgres connection string. Copy to .env.local and fill in.
# .env* is git-ignored — never commit real values.
DATABASE_URL=

# Cloudflare R2 (T4-B2 brand-asset store — real presigned-PUT upload). CORNEL-OWNED
# infra: set these locally AND on Vercel. The build/typecheck are GREEN without them
# (lazy r2.ts); only the live upload walk needs them. The bucket also needs a CORS
# policy permitting browser PUT from the app origins (localhost + the Vercel domains).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
