# Pooled Neon Postgres connection string. Copy to .env.local and fill in.
# .env* is git-ignored — never commit real values.
DATABASE_URL=

# Cloudflare R2 (T4-B2 brand-asset store — real presigned-PUT upload). CORNEL-OWNED
# infra: set these locally AND on Vercel. The build/typecheck are GREEN without them
# (lazy r2.ts); only the live upload walk needs them. The bucket also needs a CORS
# policy permitting browser PUT from the app origins (localhost + the Vercel domains).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# T7.4a — the SECOND, PRIVATE R2 bucket for CONSENT-BEARING CUSTOMER media (captured +
# normalized proof media). It has NO public domain / no r2.dev URL — customer media is
# private BY CONSTRUCTION (assetUrlForKey physically cannot address it; reads only via a
# signed, expiring presignCaptureRead). Distinct from R2_BUCKET above (PUBLIC brand assets,
# unchanged). The existing account-scoped R2 token covers both buckets (no new credential).
# Build/typecheck are GREEN without it (lazy r2.ts); only the live capture/normalize/
# withdrawal-delete walk needs it. CORS: permit browser PUT from the app origins.
R2_CAPTURES_BUCKET=

# Auth.js v5 (T6 — real auth). CORNEL-OWNED infra: set these locally AND on Vercel.
# The build/typecheck are GREEN without them (lazy auth config); only live sign-in needs
# them. AUTH_SECRET: `npx auth secret`. Google OAuth client redirect URIs must include
# http://localhost:3000/api/auth/callback/google + the Vercel domain. AUTH_EMAIL_FROM
# must be a VERIFIED Resend sender domain. AUTH_TRUST_HOST=true (or AUTH_URL) for local.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=
AUTH_TRUST_HOST=
AUTH_URL=

# The email seeded as the demo workspace OWNER (login email; the DISPLAY identity stays
# "Maya K." regardless). Defaults to amalacornel@gmail.com if unset (C1=A).
SEED_OWNER_EMAIL=

# Inngest (T7.4 — capture funnel automation; MANAGED CLOUD). CORNEL-OWNED: set on Vercel.
# The APP only EMITS events via fetch to the Event API (no Inngest SDK → app stays 11 deps).
# The build/typecheck + the durable webhook mint are GREEN without these — a missing
# INNGEST_EVENT_KEY makes emitInngest a silent no-op (the mint is the source of truth; the
# async send/normalize just isn't scheduled). The WORKER (Railway) holds INNGEST_SIGNING_KEY
# separately — see worker/.env.example + the runbook (specs/T7.4-ingest-normalize-webhook/runbook.md).
INNGEST_EVENT_KEY=
# Optional — defaults to https://inn.gs (Inngest Cloud Event API). Override for a branch env.
INNGEST_EVENT_API_URL=
