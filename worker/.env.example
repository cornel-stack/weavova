# ============================================================================
# Weavova WORKER env (Railway) — CORNEL-OWNED infra. The worker BUILDS green without
# any of these; they are needed for the LIVE path (the verify-with-real-infra walk, the
# T6 pattern). Set these as Railway service Variables. See the provisioning runbook:
# specs/T7.4-ingest-normalize-webhook/runbook.md
# ============================================================================

# --- Inngest (managed cloud) ---
# The SIGNING key authenticates Inngest Cloud → worker calls (serve reads this).
INNGEST_SIGNING_KEY=signkey-prod-...
# The EVENT key — only needed if the worker ever EMITS events (not in T7.4; optional).
# INNGEST_EVENT_KEY=...

# --- Database (the SAME Neon DB the app uses) ---
DATABASE_URL=postgresql://...@...neon.tech/...?sslmode=require

# --- Cloudflare R2 (the SAME bucket the app presigns into) ---
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=weavova-media
# (the worker does not need R2_PUBLIC_BASE_URL — it writes by object key)

# --- Resend (orchestrated capture-request send — reuses the app's keys) ---
AUTH_RESEND_KEY=re_...
AUTH_EMAIL_FROM=hello@yourdomain.com

# --- App public URL — builds the absolute /c/<token> link the email points at ---
APP_PUBLIC_URL=https://your-app.vercel.app

# --- Railway injects PORT automatically; the server defaults to 3000 otherwise ---
# PORT=3000
